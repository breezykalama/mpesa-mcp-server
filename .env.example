OIDC_DEVELOPMENT_EMAIL=operator@example.test
OIDC_DEVELOPMENT_DISPLAY_NAME=Development Operator
OIDC_DEVELOPMENT_GROUPS=
OIDC_VIEWER_GROUPS=
OIDC_APPROVER_GROUPS=
OIDC_ADMIN_GROUPS=

APPROVAL_EXPIRY_MINUTES=30
APPROVAL_REQUIRED_REVIEWERS=1
HIGH_RISK_APPROVAL_REQUIRED_REVIEWERS=2
HIGH_RISK_AMOUNT_THRESHOLD=50000
